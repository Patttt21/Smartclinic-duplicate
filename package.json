{
  "name": "smartclinic-v2",
  "private": true,
  "version": "3.4.0",
  "type": "module",
  "description": "SmartClinic: A Role-Based Web Application Integrating Predictive Analysis for Healthcare Management",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --external:vite --external:express --external:@google/genai --external:@supabase/supabase-js --external:dotenv --external:nodemailer --external:qrcode --external:twilio --external:ws --external:web-push",
    "start": "node server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "express": "4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "nodemailer": "6.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "twilio": "^6.2.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
