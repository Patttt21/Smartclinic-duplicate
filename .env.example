# ==============================================================================
# SmartClinic V2 — Separate Environment Configuration Template
# Official Title: SmartClinic: A Role-Based Web Application Integrating
#                 Predictive Analysis for Healthcare Management
# IMPORTANT: Point SUPABASE_* and VITE_SUPABASE_* ONLY to your NEW V2 Supabase
# project. Never paste credentials from the original SmartClinic database.
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Separate Supabase V2 Project (Frontend Public Config)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Separate Supabase V2 Project (Backend Server Config — NEVER expose service role key to VITE_*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push Notification VAPID Keys (Server-Side — auto-generated in /tmp if omitted in dev)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@smartclinic.ph

# Inactivity Session Timeout Overrides (Seconds — Defaults: Patient=1800, Staff=900, Admin=900)
SESSION_TIMEOUT_PATIENT_SEC=1800
SESSION_TIMEOUT_STAFF_SEC=900
SESSION_TIMEOUT_ADMIN_SEC=900

# Optional Server-Side Gemini API Key (Physician Clinical Decision Support Only)
GEMINI_API_KEY=

# Authentication & TOTP Security (Use fresh V2 secrets)
JWT_SECRET=
TOTP_SEED=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Optional Email OTP & Notification Gateway (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Optional SMS OTP & Alert Gateway (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=
